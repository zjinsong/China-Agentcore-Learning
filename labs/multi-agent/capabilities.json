{
  "_comment": "能力目录:单一事实来源。加能力改这里,不改 harness 代码。",
  "region": "cn-northwest-1",
  "experts": {
    "monitoring": {
      "port": 9001,
      "description": "监控专家:发现资源、查询 CloudWatch 指标",
      "enabled": true,
      "capabilities": [
        {
          "id": "discover_running_ec2",
          "description": "枚举运行中的 EC2 实例",
          "tool": "ec2_describe_running",
          "inputs": ["region"],
          "outputs": ["instance_ids"],
          "access": "read_only"
        },
        {
          "id": "query_ec2_metrics",
          "description": "按实例 ID 查询 CPU 指标",
          "tool": "cloudwatch_cpu",
          "inputs": ["region", "instance_ids", "time_window"],
          "outputs": ["per_instance_metrics"],
          "access": "read_only"
        }
      ]
    },
    "cloudtrail": {
      "port": 9002,
      "description": "审计专家:查询管理操作记录",
      "enabled": true,
      "capabilities": [
        {
          "id": "query_stop_events",
          "description": "查询时间窗内的 StopInstances 事件",
          "tool": "cloudtrail_stop_events",
          "inputs": ["region", "time_window"],
          "outputs": ["audit_evidence"],
          "access": "read_only"
        }
      ]
    }
  }
}
